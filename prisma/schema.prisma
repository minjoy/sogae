// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 사용자 테이블
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  nickname        String
  gender          String?
  birthyear       Int?
  personalityCode String?  @map("personality_code") // 성격 유형 코드 (예: SHCP)
  isDummy         Boolean  @default(false) @map("is_dummy") // 더미 사용자 여부
  sweetnessPoints Int      @default(0) @map("sweetness_points") // 달달함 점수
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  testResults     TestResult[]
  unifiedCards    UnifiedCard[]
  datingState     DatingState?
  dujjonkuStores  DujjonkuStore[]  // 등록한 두쫀쿠 매장
  storeReports    StoreReport[]    // 신고한 매장

  @@index([personalityCode])
  @@map("users")
}

// 테스트 결과 테이블
model TestResult {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  testType    Int      @map("test_type") // 1~5
  rawAnswers  Json     @map("raw_answers")
  scores      Json     // 각 테스트별 점수 (JSON)
  label       String   // 결과 라벨 (예: "불안형", "위로형 소비러")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, testType])
  @@map("test_results")
}

// 통합 카드 테이블
model UnifiedCard {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  cardPayload        Json     @map("card_payload") // 통합 카드 데이터
  visibilitySettings Json     @map("visibility_settings") // 공개 설정
  shareSlug          String   @unique @map("share_slug")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("unified_cards")
}

// 연애 준비 상태 테이블
model DatingState {
  userId          String   @id @map("user_id")
  readinessScore  Int      @map("readiness_score") // 0~100
  modeLabel       String   @map("mode_label") // "적극 추천", "천천히 추천", "회복 권장"
  blockedReason   String?  @map("blocked_reason")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dating_state")
}

// 두쫀쿠 매장 테이블
model DujjonkuStore {
  id          String   @id @default(uuid())
  name        String   // 매장명
  category    String   @default("dujjonku") // 카테고리: dujjonku, dubai, signature (복수 시 쉼표 구분)
  dessertName String?  @map("dessert_name") // 디저트명 (두바이파생, 시그니처간식 선택 시 필수)
  address     String   // 주소
  lat         Float    // 위도
  lng         Float    // 경도
  phone       String?  // 전화번호
  description String?  @db.Text // 매장 설명
  imageUrl    String?  @map("image_url") // 매장/상품 이미지 URL
  storeUrl    String?  @map("store_url") // 매장 링크 (인스타그램, 네이버 등)
  passOrderUrl String? @map("pass_order_url") // 패스오더 링크
  price       Int?     // 두쫀쿠 가격 (두쫀쿠 카테고리 선택 시)
  clickCount  Int      @default(0) @map("click_count") // 클릭 수
  reportCount Int      @default(0) @map("report_count") // 신고 수
  isHidden    Boolean  @default(false) @map("is_hidden") // 숨김 여부 (3회 신고 시 자동 숨김)
  isAdmin     Boolean  @default(false) @map("is_admin") // 관리자가 등록했는지 여부
  userId      String?  @map("user_id") // 등록한 사용자 (관리자 등록 시 null)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  reports      StoreReport[]
  editRequests StoreEditRequest[]

  @@index([lat, lng])
  @@index([isHidden])
  @@index([category])
  @@map("dujjonku_stores")
}

// 매장 신고 테이블
model StoreReport {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  reason    String   // 신고 사유
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  store DujjonkuStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId]) // 한 사용자가 같은 매장을 중복 신고 방지
  @@map("store_reports")
}

// 매장 수정 요청 테이블
model StoreEditRequest {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  userId      String   @map("user_id")

  // 수정 요청 데이터 (변경하려는 필드만 포함)
  name        String?  // 수정 요청 매장명
  category    String?  // 수정 요청 카테고리
  dessertName String?  @map("dessert_name") // 수정 요청 디저트명
  address     String?  // 수정 요청 주소
  lat         Float?   // 수정 요청 위도
  lng         Float?   // 수정 요청 경도
  phone       String?  // 수정 요청 전화번호
  description String?  @db.Text // 수정 요청 설명
  imageUrl    String?  @map("image_url") // 수정 요청 이미지 URL
  storeUrl    String?  @map("store_url") // 수정 요청 매장 링크
  passOrderUrl String? @map("pass_order_url") // 수정 요청 패스오더 링크
  price       Int?     // 수정 요청 두쫀쿠 가격

  status      String   @default("pending") // pending, approved, rejected
  adminNote   String?  @map("admin_note") @db.Text // 관리자 메모
  createdAt   DateTime @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at") // 처리 일시

  // Relations
  store DujjonkuStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status])
  @@map("store_edit_requests")
}
