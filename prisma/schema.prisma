// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
  other
}

enum PaymentStatus {
  simulated_success
  failed
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  name              String
  gender            Gender
  birthYear         Int
  region            String
  isEmailVerified   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  surveyResults              EconomicSurveyResult[]
  matchPreference            MatchPreference?
  emailVerificationTokens    EmailVerificationToken[]
  candidatesOwned            DailyCandidate[]         @relation("CandidatesOwned")
  candidatesAsCandidate      DailyCandidate[]         @relation("CandidatesAsCandidate")
  selectionsIAmOwner         DailySelection[]         @relation("SelectionsIAmOwner")
  selectionsIAmSelected      DailySelection[]         @relation("SelectionsIAmSelected")
  mutualMatchesAsUserA       MutualMatch[]            @relation("MutualMatchesAsUserA")
  mutualMatchesAsUserB       MutualMatch[]            @relation("MutualMatchesAsUserB")
  payments                   Payment[]

  @@index([email])
}

model EconomicSurveyResult {
  id          String   @id @default(uuid())
  userId      String?
  code3       String   // 3글자 경제 타입 코드 (예: "SPL", "CFR")
  answers     Json     // 설문 개별 문항 답변 저장
  summaryText String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  temporarySurveyTokens   TemporarySurveyToken[]

  @@index([userId])
  @@index([code3])
}

model MatchPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  isParticipating       Boolean  @default(false)
  preferredMinAge       Int?
  preferredMaxAge       Int?
  preferredRegion       String?
  preferredOppositeCodes Json?   // 선호하는 코드3 조합 리스트
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyCandidate {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  ownerUserId     String
  candidateUserId String
  createdAt       DateTime @default(now())

  // Relations
  owner     User @relation("CandidatesOwned", fields: [ownerUserId], references: [id], onDelete: Cascade)
  candidate User @relation("CandidatesAsCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([date, ownerUserId, candidateUserId])
  @@index([ownerUserId, date])
  @@index([candidateUserId])
}

model DailySelection {
  id             String   @id @default(uuid())
  date           DateTime @db.Date
  userId         String
  selectedUserId String
  createdAt      DateTime @default(now())

  // Relations
  user         User @relation("SelectionsIAmOwner", fields: [userId], references: [id], onDelete: Cascade)
  selectedUser User @relation("SelectionsIAmSelected", fields: [selectedUserId], references: [id], onDelete: Cascade)

  @@unique([date, userId, selectedUserId])
  @@index([userId, date])
  @@index([selectedUserId, date])
}

model MutualMatch {
  id                String   @id @default(uuid())
  date              DateTime @db.Date
  userAId           String
  userBId           String
  bothSelected      Boolean  @default(true)
  userAPaid         Boolean  @default(false)
  userBPaid         Boolean  @default(false)
  isContactRevealed Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  userA    User      @relation("MutualMatchesAsUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("MutualMatchesAsUserB", fields: [userBId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([date, userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Payment {
  id             String        @id @default(uuid())
  payerUserId    String
  mutualMatchId  String
  amount         Int           @default(3000)
  currency       String        @default("KRW")
  status         PaymentStatus @default(simulated_success)
  createdAt      DateTime      @default(now())

  // Relations
  payer        User        @relation(fields: [payerUserId], references: [id], onDelete: Cascade)
  mutualMatch  MutualMatch @relation(fields: [mutualMatchId], references: [id], onDelete: Cascade)

  @@index([payerUserId])
  @@index([mutualMatchId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model TemporarySurveyToken {
  id             String   @id @default(uuid())
  surveyResultId String
  token          String   @unique
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  // Relations
  surveyResult EconomicSurveyResult @relation(fields: [surveyResultId], references: [id], onDelete: Cascade)

  @@index([token])
}
